---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/docs.css";

const docs = await getCollection("docs");

const sections = Object.entries(
  docs.reduce(
    (groups, doc) => {
      const category = doc.data.category || "Documentation";

      if (!groups[category]) {
        groups[category] = [];
      }

      groups[category].push(doc);

      return groups;
    },
    {} as Record<string, typeof docs>
  )
).map(([title, items]) => ({
  title,
  items: items.sort(
    (a, b) =>
      (a.data.order ?? 999) -
      (b.data.order ?? 999)
  ),
}));
---

<MainLayout
  title="Docs"
  description="Documentation and guides."
>
  <main class="docs-page">
    <div class="docs-shell">

      <!-- SIDEBAR -->
      <aside class="docs-sidebar">

        <div class="docs-filter">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>

          <input
            type="search"
            id="docs-filter"
            placeholder="Filter docs..."
            aria-label="Filter documentation"
          />
        </div>

        <nav aria-label="Documentation">
          {sections.map((section) => (
            <div
              class="docs-section"
              data-docs-section
            >
              <p class="docs-section-title">
                {section.title}
              </p>

              <ul>
                {section.items.map((item) => (
                  <li
                    data-docs-item={item.data.title.toLowerCase()}
                  >
                    <a
                      href={`/docs/${item.slug}/`}
                      class="docs-link"
                    >
                      {item.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>

      </aside>


      <!-- CONTENT -->
      <section class="docs-content">

        <div class="docs-hero">

          <span class="docs-eyebrow">
            Documentation
          </span>

          <h1>
            Documentation
          </h1>

          <p class="docs-lead">
            Panduan, referensi, dan dokumentasi untuk memahami
            platform, tools, products, dan sistem yang tersedia.
          </p>

        </div>


        <!-- GRID -->
        <div class="docs-grid">

          {sections.map((section) => (
            <section class="docs-card-section">

              <div class="docs-card-heading">
                <h2>
                  {section.title}
                </h2>
              </div>

              <div class="docs-card-list">

                {section.items.map((item) => (
                  <a
                    href={`/docs/${item.slug}/`}
                    class="docs-card"
                  >
                    <div>
                      <h3>
                        {item.data.title}
                      </h3>

                      <p>
                        {item.data.description}
                      </p>
                    </div>

                    <span class="docs-card-arrow">
                      →
                    </span>
                  </a>
                ))}

              </div>

            </section>
          ))}

        </div>

      </section>

    </div>
  </main>


  <!-- DOCS FILTER -->
  <script>
    const filter =
      document.querySelector("#docs-filter");

    const sections =
      document.querySelectorAll(
        "[data-docs-section]"
      );

    filter?.addEventListener("input", () => {

      const query =
        (filter as HTMLInputElement)
          .value
          .trim()
          .toLowerCase();

      sections.forEach((section) => {

        let visible = 0;

        section
          .querySelectorAll("[data-docs-item]")
          .forEach((item) => {

            const text =
              item.getAttribute(
                "data-docs-item"
              ) || "";

            const match =
              text.includes(query);

            (item as HTMLElement).style.display =
              match ? "" : "none";

            if (match) {
              visible++;
            }
          });

        (section as HTMLElement).style.display =
          visible > 0 ? "" : "none";
      });
    });
  </script>

</MainLayout>

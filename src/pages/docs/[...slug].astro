---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/docs.css";

/*
 * =====================================
 * STATIC PATHS
 * =====================================
 */

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  return docs.map((doc) => ({
    params: {
      slug: doc.id,
    },

    props: {
      doc,
    },
  }));
}


/*
 * =====================================
 * CURRENT DOCUMENT
 * =====================================
 */

const { doc } = Astro.props;

const { Content } = await render(doc);


/*
 * =====================================
 * ALL DOCUMENTS
 * =====================================
 */

const docs = await getCollection("docs");


/*
 * =====================================
 * SORT DOCUMENTS
 * =====================================
 */

const sortedDocs = [...docs].sort(
  (a, b) =>
    (a.data.order ?? 999) -
    (b.data.order ?? 999)
);


/*
 * =====================================
 * URL HELPER
 *
 * Menghilangkan .md / .mdx
 * dari URL jika masih terdapat
 * pada id collection.
 * =====================================
 */

const docUrl = (id: string) =>
  `/docs/${id.replace(/\.(md|mdx)$/, "")}/`;


/*
 * =====================================
 * GROUP DOCUMENTS
 * =====================================
 */

const groups = sortedDocs.reduce(
  (acc, item) => {

    const category =
      item.data.category ||
      "Documentation";

    if (!acc[category]) {
      acc[category] = [];
    }

    acc[category].push(item);

    return acc;
  },
  {} as Record<string, typeof docs>
);


/*
 * =====================================
 * CURRENT / PREVIOUS / NEXT
 * =====================================
 */

const currentIndex =
  sortedDocs.findIndex(
    (item) => item.id === doc.id
  );

const previous =
  currentIndex > 0
    ? sortedDocs[currentIndex - 1]
    : null;

const next =
  currentIndex >= 0 &&
  currentIndex < sortedDocs.length - 1
    ? sortedDocs[currentIndex + 1]
    : null;
---

<MainLayout
  title={`${doc.data.title} — Docs`}
  description={doc.data.description}
>

  <main class="docs-page">

    <div class="docs-shell">


      <!-- =================================
           SIDEBAR
      ================================== -->

      <aside class="docs-sidebar">


        <!-- FILTER -->

        <div class="docs-filter">

          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>

          <input
            type="search"
            id="docs-filter"
            placeholder="Filter docs..."
            aria-label="Filter documentation"
          />

        </div>


        <!-- =================================
             DOCUMENTATION NAVIGATION
        ================================== -->

        <nav aria-label="Documentation">

          {
            Object.entries(groups).map(
              ([category, items]) => {

                /*
                 * Category otomatis terbuka
                 * hanya jika document aktif
                 * berada di dalam category ini.
                 */

                const isOpen =
                  items.some(
                    (item) =>
                      item.id === doc.id
                  );

                return (

                  <details
                    class="docs-section"
                    open={isOpen}
                    data-docs-section
                  >

                    <!-- CATEGORY -->

                    <summary class="docs-section-title">

                      <span>
                        {category}
                      </span>

                      <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        aria-hidden="true"
                      >
                        <path
                          d="M6 9l6 6 6-6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>

                    </summary>


                    <!-- DOCUMENTS -->

                    <ul>

                      {
                        items.map((item) => {

                          const active =
                            item.id === doc.id;

                          return (

                            <li
                              data-docs-item={
                                item.data.title
                                  .toLowerCase()
                              }
                            >

                              <a
                                href={docUrl(item.id)}
                                class:list={[
                                  "docs-link",
                                  {
                                    active,
                                  },
                                ]}
                                aria-current={
                                  active
                                    ? "page"
                                    : undefined
                                }
                              >
                                {item.data.title}
                              </a>

                            </li>

                          );

                        })
                      }

                    </ul>

                  </details>

                );

              }
            )
          }

        </nav>

      </aside>


      <!-- =================================
           DOCUMENT CONTENT
      ================================== -->

      <article class="docs-content">


        <!-- HEADER -->

        <header class="docs-header">

          <span class="docs-eyebrow">
            Documentation
          </span>

          <h1>
            {doc.data.title}
          </h1>

          {
            doc.data.description && (
              <p class="docs-lead">
                {doc.data.description}
              </p>
            )
          }

        </header>


        <!-- DIVIDER -->

        <hr />


        <!-- CONTENT -->

        <div class="docs-prose">

          <Content />

        </div>


        <!-- =================================
             PREVIOUS / NEXT
        ================================== -->

        {
          (previous || next) && (

            <nav
              class="docs-pagination"
              aria-label="Documentation navigation"
            >

              {
                previous ? (

                  <a
                    href={docUrl(previous.id)}
                    class="docs-pagination-item previous"
                  >

                    <span>
                      Previous
                    </span>

                    <strong>
                      {previous.data.title}
                    </strong>

                  </a>

                ) : (

                  <span />

                )
              }


              {
                next ? (

                  <a
                    href={docUrl(next.id)}
                    class="docs-pagination-item next"
                  >

                    <span>
                      Next
                    </span>

                    <strong>
                      {next.data.title}
                    </strong>

                  </a>

                ) : (

                  <span />

                )
              }

            </nav>

          )
        }

      </article>

    </div>

  </main>


  <!-- =====================================
       DOCS FILTER
       
       Hanya filter menggunakan JS.
       Collapse category menggunakan
       native <details>, tanpa JS.
  ====================================== -->

  <script>
    const filter =
      document.querySelector("#docs-filter");

    const sections =
      document.querySelectorAll(
        "[data-docs-section]"
      );

    filter?.addEventListener("input", () => {

      const query =
        (filter as HTMLInputElement)
          .value
          .trim()
          .toLowerCase();


      sections.forEach((section) => {

        let visible = 0;


        section
          .querySelectorAll("[data-docs-item]")
          .forEach((item) => {

            const text =
              item.getAttribute(
                "data-docs-item"
              ) || "";


            const match =
              text.includes(query);


            (
              item as HTMLElement
            ).style.display =
              match
                ? ""
                : "none";


            if (match) {
              visible++;
            }

          });


        (
          section as HTMLElement
        ).style.display =
          visible > 0
            ? ""
            : "none";

      });

    });
  </script>

</MainLayout>

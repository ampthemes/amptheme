<style is:global>
.product-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.product-price {
  flex-shrink: 0;

  padding: 7px 11px;
  border: 1px solid rgba(59, 130, 246, .25);
  border-radius: 9px;

  background: rgba(59, 130, 246, .08);
  color: var(--primary);

  font-size: 13px;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.blog-card-content h3 {
  margin-top: 0;
}

@media (max-width: 640px) {
  .product-card-top {
    gap: 8px;
  }

  .product-price {
    padding: 6px 9px;
    font-size: 12px;
  }
}
</style>

</MainLayout>

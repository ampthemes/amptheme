          <h3>
            News & Articles
          </h3>

          <p>
            Informasi dan pembahasan seputar AI,
            SEO, otomasi, teknologi, dan perkembangan
            dunia digital.
          </p>

          <a
            href="/blog/"
            class="btn btn-primary"
          >
            Baca Artikel
          </a>

        </article>


        <article class="content-card">

          <span class="card-label">
            Tools
          </span>

          <h3>
            AI Tools
          </h3>


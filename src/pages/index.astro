---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import { getCollection } from "astro:content";

import "../styles/home.css";


/* =================================
   CONTENT COLLECTIONS
================================= */

const posts = await getCollection("blog");
const tools = await getCollection("tools");
const products = await getCollection("product");


/* =================================
   LATEST ARTICLES
================================= */

const latestPosts = [...posts]
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  )
  .slice(0, 3);


/* =================================
   POPULAR TOOLS
================================= */

const popularTools =
  tools.filter((tool) => tool.data.popular).length > 0
    ? tools
        .filter((tool) => tool.data.popular)
        .slice(0, 3)
    : tools.slice(0, 3);


/* =================================
   POPULAR PRODUCTS
================================= */

const popularProducts =
  products.filter((product) => product.data.popular).length > 0
    ? products
        .filter((product) => product.data.popular)
        .slice(0, 3)
    : products.slice(0, 3);


/* =================================
   SEO
================================= */

const pageTitle =
  "AI Mr Ferdy | Platform AI Indonesia untuk Produktivitas Digital";

const pageDescription =
  "AI Mr Ferdy adalah platform AI Indonesia yang menghadirkan tools, teknologi digital, SEO, otomasi, dan solusi produktivitas modern dalam satu ekosistem.";
---


<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url()}
  isHome={true}
>


  <!-- =================================
       HERO
  ================================== -->

  <section class="hero">

    <div class="hero-container">


      <!-- HERO CONTENT -->

      <div class="hero-content">

        <span class="hero-badge">
          Website Resmi
        </span>


        <h1>
          AI Mr Ferdy
        </h1>


        <h2 class="hero-subtitle">
          Platform AI Indonesia untuk produktivitas,
          konten, SEO, dan otomasi digital.
        </h2>


        <p class="hero-description">
          <strong>AI Mr Ferdy</strong> merupakan platform
          teknologi digital yang menggabungkan kecerdasan
          buatan, AI tools, SEO, otomasi, dan berbagai
          solusi digital untuk membantu aktivitas online
          menjadi lebih praktis dan efisien.
        </p>


        <div class="hero-buttons">

          <a
            href="https://ai.termsofuse.workers.dev/"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Gunakan AI Mr Ferdy
          </a>


          <a
            href="/about/"
            class="btn btn-outline"
          >
            Tentang AI Mr Ferdy
          </a>

        </div>


        <!-- HERO FEATURES -->

        <div class="hero-features">


          <article class="feature">

            <p class="feature-title">
              AI Tools
            </p>

            <p>
              Beragam tools berbasis AI untuk membantu
              menyelesaikan berbagai kebutuhan digital
              dengan lebih cepat.
            </p>

          </article>


          <article class="feature">

            <p class="feature-title">
              SEO & Automation
            </p>

            <p>
              Pendekatan teknologi untuk mendukung
              pengelolaan website, optimasi SEO,
              dan workflow digital.
            </p>

          </article>


          <article class="feature">

            <p class="feature-title">
              Ekosistem Digital
            </p>

            <p>
              Satu ruang untuk menemukan tools,
              artikel teknologi, informasi, dan
              produk digital.
            </p>

          </article>


        </div>

      </div>


      <!-- HERO IMAGE -->

      <div class="hero-image">

        <div class="glass-card">

          <img
            src="https://aimrferdy.com/aimrferdy.png"
            fetchpriority="high"
            width="640"
            height="640"
            alt="AI Mr Ferdy - Platform AI Indonesia"
          />

        </div>


        <div class="floating-card floating-card-top">

          <p class="floating-title">
            AI Platform
          </p>

          <p>
            Modern • Cepat • Andal
          </p>

        </div>


        <div class="floating-card floating-card-bottom">

          <p class="floating-title">
            Website Resmi
          </p>

          <p>
            AI Mr Ferdy Indonesia
          </p>

        </div>

      </div>


    </div>


    <div class="hero-wave"></div>

  </section>



  <!-- =================================
       ABOUT
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <span class="section-label">
          Tentang Platform
        </span>

        <h2 class="section-title">
          Mengenal AI Mr Ferdy
        </h2>

        <p class="section-desc">
          AI Mr Ferdy adalah platform teknologi yang
          menyediakan berbagai solusi berbasis kecerdasan
          buatan untuk membantu kebutuhan digital sehari-hari.
        </p>

      </div>


      <div class="content-card">

        <p>
          Melalui satu ekosistem digital, pengguna dapat
          menemukan AI tools, pembahasan SEO, otomasi,
          pembuatan konten, artikel teknologi, serta
          produk digital yang dikembangkan untuk mendukung
          aktivitas online.
        </p>


        <p>
          Tujuannya bukan hanya menghadirkan teknologi,
          tetapi membuat teknologi tersebut lebih mudah
          dipahami dan diterapkan dalam berbagai kebutuhan
          nyata.
        </p>

      </div>

    </div>

  </section>



  <!-- =================================
       ECOSYSTEM
  ================================== -->

  <section class="section">

    <div class="container-page">

      <div class="section-heading">

        <span class="section-label">

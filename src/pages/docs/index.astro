---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/docs.css";

const docs = await getCollection("docs");

/*
 * Group docs berdasarkan category.
 * Jika category tidak ada,
 * otomatis masuk ke Documentation.
 */
const groups = docs.reduce(
  (acc, item) => {
    const category = item.data.category || "Documentation";

    if (!acc[category]) {
      acc[category] = [];
    }

    acc[category].push(item);

    return acc;
  },
  {} as Record<string, typeof docs>
);
---

<MainLayout
  title="Documentation"
  description="Documentation and guides."
>

  <main class="docs-page">

    <div class="docs-shell">

      <!-- =================================
           SIDEBAR
      ================================== -->

      <aside class="docs-sidebar">

        <div class="docs-filter">

          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>

          <input
            type="search"
            id="docs-filter"
            placeholder="Filter docs..."
            aria-label="Filter documentation"
          />

        </div>


        <nav aria-label="Documentation">

          {Object.entries(groups).map(
            ([category, items]) => (

              <div
                class="docs-section"
                data-docs-section
              >

                <p class="docs-section-title">
                  {category}
                </p>

                <ul>

                  {items
                    .sort(
                      (a, b) =>
                        (a.data.order ?? 999) -
                        (b.data.order ?? 999)
                    )
                    .map((item) => (

                      <li
                        data-docs-item={item.data.title
                          .toLowerCase()}
                      >

                        <a
                          href={`/docs/${item.id}/`}
                          class="docs-link"
                        >
                          {item.data.title}
                        </a>

                      </li>

                    ))}

                </ul>

              </div>

            )
          )}

        </nav>

      </aside>


      <!-- =================================
           DOCUMENTATION INDEX
      ================================== -->

      <article class="docs-content">

        <header class="docs-header">

          <span class="docs-eyebrow">
            Documentation
          </span>

          <h1>
            Documentation
          </h1>

          <p class="docs-lead">
            Panduan, referensi, dan dokumentasi
            untuk semua fitur dan bagian website.
          </p>

        </header>


        <hr />


        <!-- =================================
             DOCUMENTATION LIST
        ================================== -->

        <div class="docs-index">

          {Object.entries(groups).map(
            ([category, items]) => (

              <section class="docs-index-section">

                <h2>
                  {category}
                </h2>

                <div class="docs-index-grid">

                  {items
                    .sort(
                      (a, b) =>
                        (a.data.order ?? 999) -
                        (b.data.order ?? 999)
                    )
                    .map((item) => (

                      <a
                        href={`/docs/${item.id}/`}
                        class="docs-card"
                      >

                        <div class="docs-card-content">

                          <h3>
                            {item.data.title}
                          </h3>

                          {item.data.description && (
                            <p>
                              {item.data.description}
                            </p>
                          )}

                        </div>

                        <span class="docs-card-arrow">
                          →
                        </span>

                      </a>

                    ))}

                </div>

              </section>

            )
          )}

        </div>

      </article>

    </div>

  </main>


  <!-- =================================
       DOCS FILTER
  ================================== -->

  <script>
    const filter =
      document.querySelector("#docs-filter");

    const sections =
      document.querySelectorAll(
        "[data-docs-section]"
      );

    filter?.addEventListener("input", () => {

      const query =
        (filter as HTMLInputElement)
          .value
          .trim()
          .toLowerCase();

      sections.forEach((section) => {

        let visible = 0;

        section
          .querySelectorAll("[data-docs-item]")
          .forEach((item) => {

            const text =
              item.getAttribute(
                "data-docs-item"
              ) || "";

            const match =
              text.includes(query);

            (item as HTMLElement).style.display =
              match ? "" : "none";

            if (match) {
              visible++;
            }

          });

        (section as HTMLElement).style.display =
          visible > 0 ? "" : "none";

      });

    });
  </script>

</MainLayout>

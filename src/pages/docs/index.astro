---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/docs.css";

/*
 * =====================================
 * ALL DOCUMENTS
 * =====================================
 */

const docs = await getCollection("docs");


/*
 * =====================================
 * SORT DOCUMENTS
 * =====================================
 */

const sortedDocs = [...docs].sort(
  (a, b) =>
    (a.data.order ?? 999) -
    (b.data.order ?? 999)
);


/*
 * =====================================
 * DOCUMENT URL
 *
 * Pastikan URL tidak mengandung
 * .md atau .mdx.
 * =====================================
 */

const docUrl = (id: string) =>
  `/docs/${id.replace(/\.(md|mdx)$/, "")}/`;


/*
 * =====================================
 * GROUP DOCUMENTS BY CATEGORY
 * =====================================
 */

const groups = sortedDocs.reduce(
  (acc, item) => {

    const category =
      item.data.category ||
      "Documentation";

    if (!acc[category]) {
      acc[category] = [];
    }

    acc[category].push(item);

    return acc;
  },
  {} as Record<string, typeof docs>
);
---

<MainLayout
  title="Docs"
  description="Documentation and guides."
>

  <main class="docs-page">

    <div class="docs-shell">


      <!-- =================================
           SIDEBAR
      ================================== -->

      <aside class="docs-sidebar">

        <!-- FILTER -->

        <div class="docs-filter">

          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>

          <input
            type="search"
            id="docs-filter"
            placeholder="Filter docs..."
            aria-label="Filter documentation"
          />

        </div>


        <!-- =================================
             DOCUMENTATION NAVIGATION
        ================================== -->

        <nav aria-label="Documentation">

          {
            Object.entries(groups).map(
              ([category, items]) => (

                <details
                  class="docs-section"
                  data-docs-section
                >

                  <!-- CATEGORY -->

                  <summary class="docs-section-title">

                    <span>
                      {category}
                    </span>

                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      aria-hidden="true"
                    >
                      <path
                        d="M6 9l6 6 6-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                  </summary>


                  <!-- DOCUMENTS -->

                  <ul>

                    {
                      items.map((item) => (

                        <li
                          data-docs-item={
                            item.data.title
                              .toLowerCase()
                          }
                        >

                          <a
                            href={docUrl(item.id)}
                            class="docs-link"
                          >
                            {item.data.title}
                          </a>

                        </li>

                      ))
                    }

                  </ul>

                </details>

              )
            )
          }

        </nav>

      </aside>


      <!-- =================================
           DOCUMENTATION CONTENT
      ================================== -->

      <section class="docs-content">


        <!-- HERO -->

        <div class="docs-hero">

          <span class="docs-eyebrow">
            Documentation
          </span>

          <h1>
            Documentation
          </h1>

          <p class="docs-lead">
            Panduan, referensi, dan dokumentasi untuk
            memahami platform, tools, products, dan sistem
            yang tersedia.
          </p>

        </div>


        <!-- =================================
             DOCUMENTATION GRID
        ================================== -->

        <div class="docs-grid">

          {
            Object.entries(groups).map(
              ([category, items]) => (

                <section class="docs-card-section">

                  <div class="docs-card-heading">

                    <h2>
                      {category}
                    </h2>

                  </div>


                  <div class="docs-card-list">

                    {
                      items.map((item) => (

                        <a
                          href={docUrl(item.id)}
                          class="docs-card"
                        >

                          <div>

                            <h3>
                              {item.data.title}
                            </h3>

                            <p>
                              {item.data.description}
                            </p>

                          </div>


                          <span
                            class="docs-card-arrow"
                            aria-hidden="true"
                          >
                            →
                          </span>

                        </a>

                      ))
                    }

                  </div>

                </section>

              )
            )
          }

        </div>

      </section>

    </div>

  </main>


  <!-- =====================================
       DOCS FILTER

       Collapse kategori menggunakan
       native <details>.
       
       JavaScript hanya untuk filter.
  ====================================== -->

  <script>
    const filter =
      document.querySelector("#docs-filter");

    const sections =
      document.querySelectorAll(
        "[data-docs-section]"
      );

    filter?.addEventListener("input", () => {

      const query =
        (filter as HTMLInputElement)
          .value
          .trim()
          .toLowerCase();


      sections.forEach((section) => {

        let visible = 0;


        section
          .querySelectorAll("[data-docs-item]")
          .forEach((item) => {

            const text =
              item.getAttribute(
                "data-docs-item"
              ) || "";


            const match =
              text.includes(query);


            (
              item as HTMLElement
            ).style.display =
              match
                ? ""
                : "none";


            if (match) {
              visible++;
            }

          });


        (
          section as HTMLElement
        ).style.display =
          visible > 0
            ? ""
            : "none";

      });

    });
  </script>

</MainLayout>

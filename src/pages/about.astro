---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../lib/site";
import "../styles/pages.css";

const pageTitle =
  "About Ai Mr Ferdy - AI, SEO & Digital Technology";

const pageDescription =
  "Mengenal Ai Mr Ferdy, platform digital yang membahas AI, SEO, automation, tools online, teknologi web, dan pengembangan produk digital modern.";
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/about/`}
>

  <main class="page">

    <!-- HERO -->
    <section class="page-hero">
      <div class="page-container">

        <span class="page-label">
          ABOUT AI MR FERDY
        </span>

        <h1>
          Menghubungkan AI, Teknologi, dan Ekosistem Digital
        </h1>

        <p>
          Ai Mr Ferdy adalah platform digital yang mengeksplorasi
          artificial intelligence, SEO, automation, tools online,
          teknologi web, serta berbagai solusi digital yang relevan
          dengan perkembangan internet saat ini.
        </p>

      </div>
    </section>


    <!-- ABOUT -->
    <section class="page-section">
      <div class="page-container">

        <h2>
          Apa Itu Ai Mr Ferdy?
        </h2>

        <p>
          Ai Mr Ferdy merupakan ruang digital yang membahas,
          mengeksplorasi, dan menghadirkan berbagai informasi
          mengenai perkembangan teknologi modern.
        </p>

        <p>
          Pembahasan mencakup artificial intelligence, SEO,
          pengembangan website, automation, digital tools,
          serta berbagai teknologi yang dapat diterapkan
          dalam aktivitas digital sehari-hari.
        </p>

        <h3>
          AI Technology
        </h3>

        <p>
          Membahas perkembangan AI dan berbagai kemungkinan
          penerapannya dalam produk, sistem, serta kebutuhan
          digital yang semakin berkembang.
        </p>

        <h3>
          SEO & Web Development
        </h3>

        <p>
          Mengeksplorasi pengembangan website yang cepat,
          responsif, terstruktur, dan memiliki fondasi SEO
          yang baik.
        </p>

        <h3>
          Digital Tools
        </h3>

        <p>
          Menyediakan berbagai utility berbasis web yang
          dapat digunakan secara praktis langsung melalui
          browser.

        </p>

      </div>
    </section>


    <!-- FOCUS -->
    <section class="page-section">
      <div class="page-container">

        <h2>
          Fokus dan Prinsip
        </h2>

        <p>
          Ai Mr Ferdy dikembangkan dengan perhatian pada
          kualitas, kesederhanaan, performa, dan relevansi
          teknologi.
        </p>

        <h3>
          Modern Design
        </h3>

        <p>
          Mengutamakan tampilan yang sederhana dan intuitif
          agar informasi maupun tools dapat digunakan dengan
          nyaman tanpa antarmuka yang berlebihan.
        </p>

        <h3>
          High Performance
        </h3>

        <p>
          Performa menjadi salah satu perhatian utama,
          termasuk struktur halaman, kecepatan akses,
          responsivitas, dan pengalaman pengguna pada
          berbagai perangkat.
        </p>

        <h3>
          Future Ready
        </h3>

        <p>
          Platform terus mengikuti perkembangan AI,
          automation, web development, dan inovasi digital
          yang relevan dengan kebutuhan internet modern.
        </p>

      </div>
    </section>


    <!-- INFORMATION -->
    <section class="page-section">
      <div class="page-container">

        <span class="page-label">
          INFORMATION
        </span>

        <h2>
          Tentang Platform Ai Mr Ferdy
        </h2>

        <p>
          Ai Mr Ferdy berfokus pada informasi dan pengalaman
          digital yang berkaitan dengan AI, SEO, teknologi web,
          automation, dan tools online.
        </p>

        <h3>
          Apakah Ai Mr Ferdy membahas SEO?
        </h3>

        <p>
          Ya. SEO menjadi salah satu topik yang dibahas,
          terutama mengenai struktur website, performa,
          konten, dan pengembangan web modern.
        </p>

        <h3>
          Apa fokus utama Ai Mr Ferdy?
        </h3>

        <p>
          Fokus utamanya mencakup AI, automation, teknologi
          web, digital tools, SEO, serta perkembangan teknologi
          yang dapat diterapkan dalam ekosistem digital.
        </p>

        <h3>
          Apakah tersedia tools dan tutorial?
        </h3>

        <p>
          Ya. Platform menyediakan berbagai tools berbasis web,
          artikel, tutorial, dan materi informatif yang berkaitan
          dengan teknologi digital.
        </p>

      </div>
    </section>


    <!-- CTA -->
    <section class="page-cta">
      <div class="page-container">

        <h2>
          Jelajahi Dunia Teknologi Digital
        </h2>

        <p>
          Temukan berbagai pembahasan mengenai AI, SEO,
          automation, digital tools, dan pengembangan
          website modern.
        </p>

        <a
          href="https://aimrdennis.com"
          class="page-button"
        >
          Kunjungi Website
        </a>

      </div>
    </section>

  </main>

</MainLayout>

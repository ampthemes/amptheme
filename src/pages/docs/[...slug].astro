---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/docs.css";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  return docs.map((doc) => ({
    params: {
      slug: doc.id,
    },
    props: {
      doc,
    },
  }));
}

const { doc } = Astro.props;

const { Content } = await render(doc);

const docs = await getCollection("docs");

/*
 * Group docs berdasarkan category.
 * Jika frontmatter category tidak ada,
 * otomatis masuk ke "Documentation".
 */
const groups = docs.reduce((acc, item) => {
  const category = item.data.category || "Documentation";

  if (!acc[category]) {
    acc[category] = [];
  }

  acc[category].push(item);

  return acc;
}, {} as Record<string, typeof docs>);
---

<MainLayout
  title={`${doc.data.title} — Docs`}
  description={doc.data.description}
>
  <main class="docs-page">
    <div class="docs-shell">

      <!-- =================================
           SIDEBAR
      ================================== -->

      <aside class="docs-sidebar">

        <div class="docs-filter">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            />

            <line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>

          <input
            type="search"
            id="docs-filter"
            placeholder="Filter docs..."
            aria-label="Filter documentation"
          />
        </div>


        <nav aria-label="Documentation">

          {Object.entries(groups).map(
            ([category, items]) => (

              <div
                class="docs-section"
                data-docs-section
              >

                <p class="docs-section-title">
                  {category}
                </p>

                <ul>

                  {items
                    .sort(
                      (a, b) =>
                        (a.data.order ?? 999) -
                        (b.data.order ?? 999)
                    )
                    .map((item) => {

                      const href =
                        `/docs/${item.id}/`;

                      const active =
                        item.id === doc.id;

                      return (
                        <li
                          data-docs-item={item.data.title
                            .toLowerCase()}
                        >
                          <a
                            href={href}
                            class:list={[
                              "docs-link",
                              {
                                active,
                              },
                            ]}
                          >
                            {item.data.title}
                          </a>
                        </li>
                      );
                    })}

                </ul>

              </div>

            )
          )}

        </nav>

      </aside>


      <!-- =================================
           DOCUMENTATION CONTENT
      ================================== -->

      <article class="docs-content">

        <header class="docs-header">

          <span class="docs-eyebrow">
            Documentation
          </span>

          <h1>
            {doc.data.title}
          </h1>

          {doc.data.description && (
            <p class="docs-lead">
              {doc.data.description}
            </p>
          )}

        </header>


        <hr />


        <div class="docs-prose">
          <Content />
        </div>


        <!-- =================================
             PREVIOUS / NEXT
        ================================== -->

        <nav class="docs-pagination" aria-label="Documentation navigation">

          {
            (() => {
              const sortedDocs = docs.sort(
                (a, b) =>
                  (a.data.order ?? 999) -
                  (b.data.order ?? 999)
              );

              const currentIndex =
                sortedDocs.findIndex(
                  (item) => item.id === doc.id
                );

              const previous =
                currentIndex > 0
                  ? sortedDocs[currentIndex - 1]
                  : null;

              const next =
                currentIndex < sortedDocs.length - 1
                  ? sortedDocs[currentIndex + 1]
                  : null;

              return (
                <>
                  {previous ? (
                    <a
                      href={`/docs/${previous.id}/`}
                      class="docs-pagination-item previous"
                    >
                      <span>Previous</span>

                      <strong>
                        {previous.data.title}
                      </strong>
                    </a>
                  ) : (
                    <span />
                  )}

                  {next ? (
                    <a
                      href={`/docs/${next.id}/`}
                      class="docs-pagination-item next"
                    >
                      <span>Next</span>

                      <strong>
                        {next.data.title}
                      </strong>
                    </a>
                  ) : (
                    <span />
                  )}
                </>
              );
            })()
          }

        </nav>

      </article>

    </div>
  </main>


  <!-- =================================
       DOCS FILTER
  ================================== -->

  <script>
    const filter =
      document.querySelector("#docs-filter");

    const sections =
      document.querySelectorAll(
        "[data-docs-section]"
      );

    filter?.addEventListener("input", () => {
      const query =
        (filter as HTMLInputElement)
          .value
          .trim()
          .toLowerCase();

      sections.forEach((section) => {

        let visible = 0;

        section
          .querySelectorAll("[data-docs-item]")
          .forEach((item) => {

            const text =
              item.getAttribute(
                "data-docs-item"
              ) || "";

            const match =
              text.includes(query);

            (
              item as HTMLElement
            ).style.display =
              match ? "" : "none";

            if (match) {
              visible++;
            }
          });

        (
          section as HTMLElement
        ).style.display =
          visible > 0 ? "" : "none";
      });
    });
  </script>
</MainLayout>
